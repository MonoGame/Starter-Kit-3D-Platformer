{
    "version": "2.0.0",
    "tasks": [
//#if (IncludeDesktop)
        {
            "label": "build-platformer-desktop",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Desktop/Platformer3D.csproj"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$msCompile"
        }
//#endif
//#if (IncludeWindows)
        ,{
            "label": "build-platformer-windows",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Windows/Platformer3D.csproj"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$msCompile"
        }
//#endif
//#if (IncludeAndroid)
        ,{
            "label": "build-platformer-android",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Android/Platformer3D.csproj",
                "-t:Run",
                "/property:Configuration=Debug"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        }
//#endif
//#if (IncludeiOS)
        ,{
            "label": "build-platformer-ios",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/iOS/Platformer3D.csproj",
                "-t:Run",
                "/property:Configuration=Debug"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$msCompile"
        }
//#endif
    ]
}
