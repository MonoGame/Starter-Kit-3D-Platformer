<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>net.monogame.3DPlatformer</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AssemblyName>3DPlatformer</AssemblyName>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);DEVMODE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Source\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.5-develop.13" />
  </ItemGroup>
  <Target Name="BuildContent" BeforeTargets="Build">
    <PropertyGroup>
      <ContentTarget>Android</ContentTarget>
      <ContentOutput>$(ProjectDir)$(OutputPath)</ContentOutput>
      <ContentTemp>$(ProjectDir)$(IntermediateOutputPath)</ContentTemp>
      <ContentArgs>build -p $(ContentTarget) -s Assets -o $(ContentOutput) -i $(ContentTemp)</ContentArgs>
    </PropertyGroup>
    <MSbuild Projects="..\..\Content\Content.csproj" Targets="Build;Run" Properties="RunArguments=$(ContentArgs);" />
  </Target>
</Project>