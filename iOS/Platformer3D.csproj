<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
    <AssemblyName>Platformer3D</AssemblyName>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);DEVMODE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="3.8.5-preview.*" />
  </ItemGroup>
  <PropertyGroup>
    <MonoGamePlatform>iOS</MonoGamePlatform>
  </PropertyGroup>
  <Import Project="..\Content\BuildContent.targets" />
</Project>
