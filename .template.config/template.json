{
  "$schema": "http://json.schemastore.org/template",
  "author": "MonoGame Foundation",
  "classifications": [
    "MonoGame",
    "Game",
    "3D",
    "Platformer",
    "StarterKit",
    "Kenney"
  ],
  "identity": "MonoGame.Kenney.StarterKit.3DPlatformer",
  "name": "Kenny StarterKit 3D Platformer",
  "shortName": "mg-3dplatformer",
  "sourceName": "Starter-Kit-3D-Platformer", // TODO: Maybe we sould rename the solution to Platformer3D.
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "preferNameDirectory": false,

  "monogame": {
    // TODO: How do we make a long description here with nice formatting?
    "longDescription": "Lorem ipsum dolor sit amet consectetur adipiscing elit. Quisque faucibus ex sapien vitae pellentesque sem placerat. In id cursus mi pretium tellus duis convallis. Tempus leo eu aenean sed diam urna tempor. Pulvinar vivamus fringilla lacus nec metus bibendum egestas. Iaculis massa nisl malesuada lacinia integer nunc posuere. Ut hendrerit semper vel class aptent taciti sociosqu. Ad litora torquent per conubia nostra inceptos himenaeos.",
    "images": [
      // TODO: Is this a good way to get the images?
      // Could we assume a relative local path after the template is cloned?
      "https://github.com/MonoGame/Starter-Kit-3D-Platformer/blob/screenshot.png?raw=true"
    ],
    "videos": [
      // TODO: We may need to use some other embedded url here maybe.
      "https://www.youtube.com/watch?v=odFSoTYmrAQ"
    ],
    "links": [
      {
        "label": "Source Code",
        "url": "https://github.com/MonoGame/Starter-Kit-3D-Platformer"
      },
      {
        "label": "Documentation",
        "url": "https://github.com/MonoGame/Starter-Kit-3D-Platformer/blob/main/README.md"
      }
    ]
  },

  "symbols": {
    "GameTitle": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "3D Platformer",
      "defaultValue": "3D Platformer",
      "description": "The display name for your game that players will see."
    },
    "AssemblyName": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "3DPlatformer",
      "defaultValue": "3DPlatformer",
      "description": "The name for your built assembly file."
    },
    "Platforms": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "choices": [
        {
          "choice": "android",
          "description": "Android mobile device platform"
        },
        {
          "choice": "ios",
          "description": "Apple iOS device platform"
        },
        {
          "choice": "desktop",
          "description": "Cross-platform Windows, MacOS, and Linux desktop platform using Vulkan"
        },
        {
          "choice": "windows",
          "description": "Windows desktop platform using DirectX 12"
        }
      ],
      "defaultValue": "desktop",
      "description": "Target platforms you want to support."
    },

    "ProjectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "asIs", // The name should already be filename safe
      "replaces": "Platformer3D",
      "fileRename": "Platformer3D"
    },
    "IncludeAndroid": {
      "type": "computed",
      "value": "Platforms == android"
    },
    "IncludeIOS": {
      "type": "computed",
      "value": "Platforms == ios"
    },
    "IncludeWindows": {
      "type": "computed",
      "value": "Platforms == windows"
    },
    "IncludeDesktop": {
      "type": "computed",
      "value": "Platforms == desktop"
    }
  },

  "forms": {
    "asIs": {
      "identifier": "replace",
      "pattern": "(?!)",
      "replacement": ""
    }
  },

  "sources": [
    {
      "modifiers": [
        {
          "copyOnly": [
            "**/*.fbx",
            "**/*.blend",
            "**/*.md"
          ]
        },
        {
          "exclude": [
            ".git/**",
            ".github/**",
            ".vs/**"
          ]
        },
        {
          "condition": "(!IncludeAndroid)",
          "exclude": [
            "Android/**"
          ]
        },
        {
          "condition": "(!IncludeIOS)",
          "exclude": [
            "iOS/**"
          ]
        },
        {
          "condition": "(!IncludeWindows)",
          "exclude": [
            "Windows/**"
          ]
        },
        {
          "condition": "(!IncludeDesktop)",
          "exclude": [
            "Desktop/**"
          ]
        }
      ]
    }
  ],

  /*
		NOTE: This is required because the template engine doesn't yet 
		recognize the .slnx format as XML to be preprocessed.
	*/
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "actionableIf": [
              "<!--#if"
            ],
            "actionableElse": [
              "#else",
              "<!--#else"
            ],
            "actionableElseif": [
              "#elseif",
              "<!--#elseif",
              "#elif",
              "<!--#elif"
            ],
            "endif": [
              "#endif",
              "<!--#endif"
            ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  }
}
