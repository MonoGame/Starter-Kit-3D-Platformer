{
  "$schema": "http://json.schemastore.org/template",
  "author": "MonoGame Foundation",
  "classifications": [
    "MonoGame",
    "Game",
    "3D",
    "Platformer",
    "StarterKit",
    "Kenney",
    "CrossPlatform",
    "Physics",
    "Collision",
    "PostProcessing",
    "Gamepad"
  ],
  "identity": "MonoGame.Templates.StarterKit3DPlatformer.CSharp",
  "name": "Kenny 3D Platformer Starter Kit for MonoGame",
  "description": "A fully-featured 3D platformer starter kit ported from Kenney's Godot starter kit.",
  "shortName": "mg-3dplatformer",
  "sourceName": "Platformer3D",
  "defaultName": "My3DPlatformer",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "preferNameDirectory": true,

  "monogame": {
    "longDescription": "# MonoGame 3D Platformer Starter Kit\n\nA complete 3D platformer game ported from [Kenney's Godot 4.3 Starter Kit](https://kenney.nl/tools/starter-kits), rebuilt entirely in MonoGame. A perfect starting point for a 3D game without building the fundamentals from scratch.\n\n## Features\n\n- A character controller with walk, run, and double jump\n- Collectible coins with HUD counter\n- Falling platforms that drop when the player steps on them\n- Moving platforms along predefined paths\n- Convex hull collision system (custom content pipeline processor)\n- Bloom, shadow, and vignette post-processing effects\n- Camera with rotate and zoom controls\n- Full gamepad support\n- Level data designed in Blender and exported to JSON\n- Multi-platform: DesktopVK (Vulkan), WindowsDX12, Android, iOS\n\n## Assets\n\nAll art assets (sprites, 3D models, sound effects) are [CC0 licensed](https://creativecommons.org/public-domain/cc0/) from Kenney.nl. Code is MIT licensed.",
    "images": [
      "https://raw.githubusercontent.com/MonoGame/Starter-Kit-3D-Platformer/refs/heads/main/ScreenShots/screenshot.png"
    ],
    "videos": [
      "https://www.youtube.com/watch?v=odFSoTYmrAQ"
    ],
    "links": [
      {
        "label": "Source Code",
        "url": "https://github.com/MonoGame/Starter-Kit-3D-Platformer"
      },
      {
        "label": "Documentation",
        "url": "https://github.com/MonoGame/Starter-Kit-3D-Platformer/blob/main/README.md"
      },
      {
        "label": "Kenney Starter Kits",
        "url": "https://kenney.nl/tools/starter-kits"
      }
    ],

    "monoGameVersion": "3.8.5",
    "platforms": {
      "desktop": { "target": "DesktopVK",   "folder": "Desktop" },
      "windows": { "target": "WindowsDX12", "folder": "Windows" },
      "android": { "target": "Android",     "folder": "Android" },
      "ios":     { "target": "iOS",         "folder": "iOS" }
    }
  },

  "symbols": {
    "GameTitle": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "3D Platformer",
      "defaultValue": "3D Platformer",
      "description": "The display name for your game that players will see."
    },
    "AssemblyName": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "3DPlatformer",
      "defaultValue": "3DPlatformer",
      "description": "The name for your built assembly file."
    },
    "Platforms": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "choices": [
        {
          "choice": "android",
          "description": "Android mobile device platform"
        },
        {
          "choice": "ios",
          "description": "Apple iOS device platform"
        },
        {
          "choice": "desktop",
          "description": "Cross-platform Windows, MacOS, and Linux desktop platform using Vulkan"
        },
        {
          "choice": "windows",
          "description": "Windows desktop platform using DirectX 12"
        }
      ],
      "defaultValue": "desktop",
      "description": "Target platforms you want to support."
    },
    "IncludeAndroid": {
      "type": "computed",
      "value": "Platforms == android"
    },
    "IncludeIOS": {
      "type": "computed",
      "value": "Platforms == ios"
    },
    "IncludeWindows": {
      "type": "computed",
      "value": "Platforms == windows"
    },
    "IncludeDesktop": {
      "type": "computed",
      "value": "Platforms == desktop"
    }
  },

  "sources": [
    {
      "modifiers": [
        {
          "copyOnly": [
            "**/*.fbx",
            "**/*.blend",
            "**/*.md"
          ]
        },
        {
          "exclude": [
            ".git/**",
            ".github/**",
            ".vs/**",
            ".idea/**"
          ]
        },
        {
          "condition": "(!IncludeAndroid)",
          "exclude": [
            "Android/**"
          ]
        },
        {
          "condition": "(!IncludeIOS)",
          "exclude": [
            "iOS/**"
          ]
        },
        {
          "condition": "(!IncludeWindows)",
          "exclude": [
            "Windows/**"
          ]
        },
        {
          "condition": "(!IncludeDesktop)",
          "exclude": [
            "Desktop/**"
          ]
        }
      ]
    }
  ],
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "actionableIf": [
              "<!--#if"
            ],
            "actionableElse": [
              "#else",
              "<!--#else"
            ],
            "actionableElseif": [
              "#elseif",
              "<!--#elseif",
              "#elif",
              "<!--#elif"
            ],
            "endif": [
              "#endif",
              "<!--#endif"
            ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  }
}