    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Source\Base\AnimationData.cs" Link="Builder\AnimationData.cs" />
    <Compile Include="..\Source\Base\Contact.cs" Link="Builder\Contact.cs" />
    <Compile Include="..\Source\Base\ConvexHull.cs" Link="Builder\ConvexHull.cs" />
    <Compile Include="..\Source\Base\GameConstants.cs" Link="Builder\GameConstants.cs" />
