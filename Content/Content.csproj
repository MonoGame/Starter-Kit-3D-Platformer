    <Compile Include="..\Source\Base\SceneAssetContent.cs" Link="Builder\SceneAssetContent.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets/*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Content.Pipeline" />
    <PackageReference Include="MonoGame.Framework.Native">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MIConvexHull" />
    <PackageReference Include="MonoGame.Library.FreeType" />
    <PackageReference Include="MonoGame.Library.MojoShader" />
    <PackageReference Include="MonoGame.Tool.Basisu" />
    <PackageReference Include="MonoGame.Tool.Crunch" />
    <PackageReference Include="MonoGame.Tool.Dxc" />
    <PackageReference Include="MonoGame.Tool.FFmpeg" />
    <PackageReference Include="MonoGame.Tool.FFprobe" />
  </ItemGroup>

</Project>